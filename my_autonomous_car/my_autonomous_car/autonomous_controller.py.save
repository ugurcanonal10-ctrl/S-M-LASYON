import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist
from nav_msgs.msg import Odometry
from sensor_msgs.msg import Image
from cv_bridge import CvBridge
import cv2
import numpy as np
# ================= YENİ EKLENEN KISIM =================
from rclpy.qos import qos_profile_sensor_data
# ======================================================

class AutonomousController(Node):
    def __init__(self):
        super().__init__('autonomous_controller')

        self.publisher_ = self.create_publisher(Twist, '/cmd_vel', 10)
        self.odom_sub = self.create_subscription(Odometry, '/odom', self.odom_callback, 10)
        
        # ================= İŞTE BÜYÜK DEĞİŞİKLİK =================
        # 10 yerine 'qos_profile_sensor_data' yazarak kameranın frekansına uyum sağladık
        self.image_sub = self.create_subscription(
            Image, 
            '/camera/image_raw', 
            self.image_callback, 
            qos_profile_sensor_data
        )
        # =========================================================
        
        self.bridge = CvBridge()
        self.TEST_MODU = True  
        self.camera_alive = False 
        self.current_speed = 0.0
        self.cross_track_error = 0.0
        self.dt = 0.033  
        self.timer = self.create_timer(self.dt, self.control_loop)

    def odom_callback(self, msg):
        self.current_speed = msg.twist.twist.linear.x

    def image_callback(self, data):
        if not self.camera_alive:
            self.get_logger().info("==================================================")
            self.get_logger().info(">>> KAMERA GÖZÜ AÇILDI! Görüntü başarıyla alınıyor <<<")
            self.get_logger().info("==================================================")
            self.camera_alive = True

        try:
            cv_image = self.bridge.imgmsg_to_cv2(data, "bgr8")
            height, width, _ = cv_image.shape
            
            crop_img = cv_image[int(height*0.4):height, 0:width]
            gray = cv2.cvtColor(crop_img, cv2.COLOR_BGR2GRAY)
            _, thresh = cv2.threshold(gray, 200, 255, cv2.THRESH_BINARY)
            
            contours, _ = cv2.findContours(thresh, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
            
            display_img = crop_img.copy()
            cv2.drawContours(display_img, contours, -1, (255, 0, 255), 3)

            valid_contours = [c for c in contours if cv2.contourArea(c) > 100]
            valid_contours = sorted(valid_contours, key=cv2.contourArea, reverse=True)[:2]

            left_cx = None
            right_cx = None
            ideal_center = width / 2.0

            if len(valid_contours) == 2:
                M1 = cv2.moments(valid_contours[0])
                M2 = cv2.moments(valid_contours[1])
                cx1 = int(M1["m10"] / M1["m00"]) if M1["m00"] > 0 else int(ideal_center)
                cx2 = int(M2["m10"] / M2["m00"]) if M2["m00"] > 0 else int(ideal_center)
                
                left_cx = min(cx1, cx2)
                right_cx = max(cx1, cx2)
                lane_center = (left_cx + right_cx) / 2.0
            elif len(valid_contours) == 1:
                M1 = cv2.moments(valid_contours[0])
                cx1 = int(M1["m10"] / M1["m00"]) if M1["m00"] > 0 else int(ideal_center)
                if cx1 < ideal_center:
                    left_cx = cx1
                    lane_center = left_cx + 200
                else:
                    right_cx = cx1
                    lane_center = right_cx - 200
            else:
                lane_center = ideal_center

            self.cross_track_error = (ideal_center - lane_center) / ideal_center

            y_pos = int(crop_img.shape[0] / 2)
            if left_cx is not None:
                cv2.circle(display_img, (left_cx, y_pos), 8, (0, 0, 255), -1)
            if right_cx is not None:
                cv2.circle(display_img, (right_cx, y_pos), 8, (255, 0, 0), -1)
            cv2.circle(display_img, (int(lane_center), y_pos), 10, (0, 255, 0), -1)

            cv2.imshow("Teshis Modu", display_img)
            cv2.waitKey(1)

        except Exception as e:
            self.get_logger().error(f"OPENCV ÇÖKTÜ: {str(e)}")

    def control_loop(self):
        msg = Twist()
        msg.linear.x = 0.0
        msg.angular.z = 0.0
        self.publisher_.publish(msg)
        
        if not self.camera_alive:
            self.get_logger().warning("Kamera verisi bekleniyor... Sinyal yok!")

def main(args=None):
    rclpy.init(args=args)
    node = AutonomousController()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        cv2.destroyAllWindows()
        rclpy.shutdown()

if __name__ == '__main__':
    main()

