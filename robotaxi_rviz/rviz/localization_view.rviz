Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /GroundTruthPath1
        - /EkfEstimatePath1
        - /RawGpsPath1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 1.5
      Value: true

    - Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Value: true

    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: SlamMap
      Topic:
        Value: /map
      Color Scheme: map
      Value: true

    # ---- GROUND TRUTH: beyaz, kovaryans (gercek deger oldugu icin ~0,
    #      gorsel referans amacli cizdiriliyor) ----
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: GroundTruthPath
      Topic:
        Value: /ground_truth/odom
      Keep: 2000
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Shape:
        Value: Arrow
        Alpha: 1
        Color: 255; 255; 255
        Head Length: 0.2
        Head Radius: 0.1
        Shaft Length: 0.3
        Shaft Radius: 0.04
      Covariance:
        Position:
          Alpha: 0.3
          Color: 255; 255; 255
          Scale: 1
          Value: true
        Orientation:
          Alpha: 0.3
          Color: 255; 255; 0
          Scale: 1
          Value: false
        Value: true
      Value: true

    # ---- EKF TAHMİNİ: yeşil, kovaryans elipsi açık ----
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: EkfEstimatePath
      Topic:
        Value: /odometry/filtered
      Keep: 2000
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Shape:
        Value: Arrow
        Alpha: 1
        Color: 0; 255; 0
        Head Length: 0.2
        Head Radius: 0.1
        Shaft Length: 0.3
        Shaft Radius: 0.04
      Covariance:
        Position:
          Alpha: 0.4
          Color: 0; 255; 0
          Scale: 1
          Value: true
        Orientation:
          Alpha: 0.4
          Color: 0; 255; 255
          Scale: 1
          Value: false
        Value: true
      Value: true

    # ---- HAM GPS (navsat_transform ciktisi, odom cercevesinde): mavi ----
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: RawGpsPath
      Topic:
        Value: /odometry/gps
      Keep: 2000
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Shape:
        Value: Arrow
        Alpha: 1
        Color: 0; 85; 255
        Head Length: 0.2
        Head Radius: 0.1
        Shaft Length: 0.3
        Shaft Radius: 0.04
      Covariance:
        Position:
          Alpha: 0.3
          Color: 0; 85; 255
          Scale: 1
          Value: true
        Orientation:
          Alpha: 0.3
          Color: 255; 0; 255
          Scale: 1
          Value: false
        Value: true
      Value: true

    - Class: rviz_default_plugins/LaserScan
      Enabled: false
      Name: LaserScan
      Topic:
        Value: /scan
      Size (m): 0.05
      Color: 255; 0; 0
      Value: false

  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 35
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.9
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0

Window Geometry:
  Height: 950
  Width: 1500
  X: 40
  Y: 40
