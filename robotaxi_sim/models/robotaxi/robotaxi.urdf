<?xml version="1.0"?>
<robot name="robotaxi">

  <!-- Gövde -->
  <link name="base_link">
    <visual>
      <geometry><box size="2.5 1.2 0.5"/></geometry>
      <material name="white"><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <geometry><box size="2.5 1.2 0.5"/></geometry>
    </collision>
    <inertial>
      <mass value="1500"/>
      <inertia ixx="400" ixy="0" ixz="0" iyy="800" iyz="0" izz="1200"/>
    </inertial>
  </link>

  <!-- Sol ön tekerlek -->
  <link name="wheel_fl">
    <visual>
      <geometry><cylinder radius="0.35" length="0.2"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.35" length="0.2"/></geometry>
    </collision>
    <inertial>
      <mass value="20"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
  </link>
  <joint name="joint_fl" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fl"/>
    <origin xyz="0.9 0.7 -0.25" rpy="1.5707 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Sağ ön tekerlek -->
  <link name="wheel_fr">
    <visual>
      <geometry><cylinder radius="0.35" length="0.2"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.35" length="0.2"/></geometry>
    </collision>
    <inertial>
      <mass value="20"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
  </link>
  <joint name="joint_fr" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fr"/>
    <origin xyz="0.9 -0.7 -0.25" rpy="1.5707 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Sol arka tekerlek -->
  <link name="wheel_rl">
    <visual>
      <geometry><cylinder radius="0.35" length="0.2"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.35" length="0.2"/></geometry>
    </collision>
    <inertial>
      <mass value="20"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
  </link>
  <joint name="joint_rl" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rl"/>
    <origin xyz="-0.9 0.7 -0.25" rpy="1.5707 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Sağ arka tekerlek -->
  <link name="wheel_rr">
    <visual>
      <geometry><cylinder radius="0.35" length="0.2"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.35" length="0.2"/></geometry>
    </collision>
    <inertial>
      <mass value="20"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
  </link>
  <joint name="joint_rr" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rr"/>
    <origin xyz="-0.9 -0.7 -0.25" rpy="1.5707 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- LiDAR -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.1" length="0.1"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.35" rpy="0 0 0"/>
  </joint>

  <!-- Ön Kamera (geniş açı - şerit algılama) -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.05 0.15 0.05"/></geometry>
      <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="1.3 0 0.15" rpy="0 0.15 0"/>
  </joint>

  <!-- Arka Kamera -->
  <link name="camera_rear_link">
    <visual>
      <geometry><box size="0.05 0.1 0.05"/></geometry>
      <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
  </link>
  <joint name="camera_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_rear_link"/>
    <origin xyz="-1.3 0 0.15" rpy="0 0 3.14159"/>
  </joint>

  <!-- IMU -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.05 0.05 0.02"/></geometry>
      <material name="blue"><color rgba="0 0 1 1"/></material>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- GPS -->
  <link name="gps_link">
    <visual>
      <geometry><box size="0.05 0.05 0.02"/></geometry>
      <material name="green"><color rgba="0 1 0 1"/></material>
    </visual>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
  </joint>

  <!-- Ultrasonik - Ön -->
  <link name="ultrasonic_front">
    <visual>
      <geometry><box size="0.05 0.05 0.03"/></geometry>
      <material name="yellow"><color rgba="1 1 0 1"/></material>
    </visual>
  </link>
  <joint name="ultrasonic_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_front"/>
    <origin xyz="1.26 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Ultrasonik - Arka -->
  <link name="ultrasonic_rear">
    <visual>
      <geometry><box size="0.05 0.05 0.03"/></geometry>
      <material name="yellow"><color rgba="1 1 0 1"/></material>
    </visual>
  </link>
  <joint name="ultrasonic_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_rear"/>
    <origin xyz="-1.26 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Ultrasonik - Sol -->
  <link name="ultrasonic_left">
    <visual>
      <geometry><box size="0.05 0.05 0.03"/></geometry>
      <material name="yellow"><color rgba="1 1 0 1"/></material>
    </visual>
  </link>
  <joint name="ultrasonic_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_left"/>
    <origin xyz="0 0.61 0" rpy="0 0 1.5707"/>
  </joint>

  <!-- Ultrasonik - Sağ -->
  <link name="ultrasonic_right">
    <visual>
      <geometry><box size="0.05 0.05 0.03"/></geometry>
      <material name="yellow"><color rgba="1 1 0 1"/></material>
    </visual>
  </link>
  <joint name="ultrasonic_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_right"/>
    <origin xyz="0 -0.61 0" rpy="0 0 -1.5707"/>
  </joint>

  <!-- ===== GAZEBO PLUGIN'LER ===== -->

  <!-- Differential drive -->
  <gazebo>
    <plugin name="differential_drive" filename="libgazebo_ros_diff_drive.so">
      <left_joint>joint_rl</left_joint>
      <right_joint>joint_rr</right_joint>
      <wheel_separation>1.4</wheel_separation>
      <wheel_diameter>0.7</wheel_diameter>
      <max_wheel_torque>200</max_wheel_torque>
      <max_wheel_acceleration>10.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
    </plugin>
  </gazebo>

  <!-- LiDAR plugin -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.3</min>
          <max>30.0</max>
        </range>
      </ray>
      <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
        <ros><topic>scan</topic></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Ön Kamera plugin (geniş açı) -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="front_camera">
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.9</horizontal_fov>
        <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
        <clip><near>0.02</near><far>300</far></clip>
      </camera>
      <plugin name="gazebo_ros_front_camera" filename="libgazebo_ros_camera.so">
        <ros><topic>front_camera/image_raw</topic></ros>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Arka Kamera plugin -->
  <gazebo reference="camera_rear_link">
    <sensor type="camera" name="rear_camera">
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.5707</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.02</near><far>100</far></clip>
      </camera>
      <plugin name="gazebo_ros_rear_camera" filename="libgazebo_ros_camera.so">
        <ros><topic>rear_camera/image_raw</topic></ros>
      </plugin>
    </sensor>
  </gazebo>

  <!-- IMU plugin -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="gazebo_ros_imu" filename="libgazebo_ros_imu_sensor.so">
        <ros><topic>imu</topic></ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>
  <!-- GPS plugin -->
  <gazebo reference="gps_link">
    <sensor name="gps_sensor" type="gps">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <gps>
        <position_sensing>
          <horizontal>
            <noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise>
          </horizontal>
          <vertical>
            <noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise>
          </vertical>
        </position_sensing>
      </gps>
      <plugin name="gazebo_ros_gps" filename="libgazebo_ros_gps_sensor.so">
        <ros><topic>gps</topic></ros>
      </plugin>
    </sensor>
  </gazebo>

  <!-- GPS plugin -->
  <gazebo reference="gps_link">
    <sensor name="gps_sensor" type="gps">
      <update_rate>10</update_rate>
      <plugin name="gazebo_ros_gps" filename="libgazebo_ros_gps_sensor.so">        <ros><topic>gps</topic></ros>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Ultrasonik Ön plugin -->
  <gazebo reference="ultrasonic_front">
    <sensor type="ray" name="ultrasonic_front_sensor">
      <update_rate>20</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <min_angle>-0.1</min_angle>
            <max_angle>0.1</max_angle>
          </horizontal>
        </scan>
        <range><min>0.02</min><max>4.0</max></range>
      </ray>
      <plugin name="gazebo_ros_ultrasonic_front" filename="libgazebo_ros_ray_sensor.so">
        <ros><topic>ultrasonic/front</topic></ros>
        <output_type>sensor_msgs/Range</output_type>
        <radiation_type>ultrasound</radiation_type>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Ultrasonik Arka plugin -->
  <gazebo reference="ultrasonic_rear">
    <sensor type="ray" name="ultrasonic_rear_sensor">
      <update_rate>20</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <min_angle>-0.1</min_angle>
            <max_angle>0.1</max_angle>
          </horizontal>
        </scan>
        <range><min>0.02</min><max>4.0</max></range>
      </ray>
      <plugin name="gazebo_ros_ultrasonic_rear" filename="libgazebo_ros_ray_sensor.so">
        <ros><topic>ultrasonic/rear</topic></ros>
        <output_type>sensor_msgs/Range</output_type>
        <radiation_type>ultrasound</radiation_type>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Ultrasonik Sol plugin -->
  <gazebo reference="ultrasonic_left">
    <sensor type="ray" name="ultrasonic_left_sensor">
      <update_rate>20</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <min_angle>-0.1</min_angle>
            <max_angle>0.1</max_angle>
          </horizontal>
        </scan>
        <range><min>0.02</min><max>4.0</max></range>
      </ray>
      <plugin name="gazebo_ros_ultrasonic_left" filename="libgazebo_ros_ray_sensor.so">
        <ros><topic>ultrasonic/left</topic></ros>
        <output_type>sensor_msgs/Range</output_type>
        <radiation_type>ultrasound</radiation_type>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Ultrasonik Sağ plugin -->
  <gazebo reference="ultrasonic_right">
    <sensor type="ray" name="ultrasonic_right_sensor">
      <update_rate>20</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <min_angle>-0.1</min_angle>
            <max_angle>0.1</max_angle>
          </horizontal>
        </scan>
        <range><min>0.02</min><max>4.0</max></range>
      </ray>
      <plugin name="gazebo_ros_ultrasonic_right" filename="libgazebo_ros_ray_sensor.so">
        <ros><topic>ultrasonic/right</topic></ros>
        <output_type>sensor_msgs/Range</output_type>
        <radiation_type>ultrasound</radiation_type>
      </plugin>
    </sensor>
  </gazebo>

</robot>
